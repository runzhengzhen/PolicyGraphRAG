include LICENSE THIRD_PARTY_NOTICES.md README.md CONTRIBUTING.md SECURITY.md CHANGELOG.md CITATION.cff .env.example .gitignore
recursive-include docs *.md
recursive-include examples *.jsonl *.csv *.md
recursive-include config *.json
recursive-include tests *.py
recursive-include skills *.md
recursive-include scripts *.py
include run_demo.sh
recursive-include .github *.yml
prune outputs
prune data
prune private
prune .git
global-exclude __pycache__ *.py[cod] .DS_Store
